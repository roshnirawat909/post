<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Edit</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 flex flex-col items-center justify-center min-h-screen p-5 space-y-10">

  <!-- Main Card -->
  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
    <div class="flex justify-end mb-2">
      <a href="/logout" class="text-blue-500 hover:underline text-sm">Logout</a>
    </div>
    <h4 class="text-center text-gray-600 mb-4">Edit your post.</h4>
<!--/update/<% post._id %>-->
    <form action="/update/<% post._id %>" method="post" class="space-y-4">
      <textarea name="content" class="w-full p-3 border border-gray-300 rounded-md text-black resize-none" rows="4" placeholder="Edit your post" required><%= post.content %></textarea>
      <input type="submit" value="Update your  Post" class="w-full bg-amber-300 text-black py-2 rounded-md hover:bg-amber-500 cursor-pointer" />
    </form>
  </div>

 

</body>
</html>